{
    "name": "web",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "analyze:boilerplate": "node scripts/analyze-prompt-boilerplate.mjs",
        "audit:adsense-artifacts": "node scripts/audit-adsense-artifacts.mjs",
        "audit:adsense-preflight": "node scripts/audit-adsense-preflight.mjs",
        "audit:content": "node scripts/verify-phase3-content.mjs",
        "audit:content:external": "node scripts/verify-phase3-content.mjs --external",
        "audit:image-provenance": "node scripts/generate-image-provenance-register.mjs",
        "audit:image-rights": "node scripts/verify-image-rights.mjs",
        "audit:isr": "node scripts/audit-isr-usage.mjs",
        "audit:production-performance": "node scripts/audit-production-performance.mjs",
        "audit:production-security": "node scripts/audit-production-security.mjs",
        "audit:prompt-faqs": "node scripts/audit-and-fix-prompt-faqs.mjs",
        "audit:prompt-indexing": "node scripts/verify-prompt-indexing.mjs",
        "audit:provenance": "node scripts/generate-image-provenance-register.mjs",
        "audit:quarantine": "node scripts/generate-quarantined-review.mjs",
        "audit:trademarks": "node scripts/audit-trademark-risks.mjs",
        "build": "next build --webpack",
        "build:analyze": "node scripts/patch-next-lockfile.cjs && node scripts/build-content.mjs && next build --webpack",
        "build:thumbnails": "node scripts/generate-prompt-thumbnails.mjs",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
        "check:boilerplate:duplicates": "node scripts/check-boilerplate-duplicates.mjs",
        "cloudflare-build": "npm run sync:content && npm run audit:isr && npm run verify:quarantine-public && npm run verify:tombstones && npm run verify:production-env && npm run audit:image-provenance && npm run audit:adsense-preflight && npm run lint && npm run build && npm run audit:adsense-artifacts",
        "create:ads-txt": "node scripts/create-verified-ads-txt.mjs",
        "db:backfill:all-editorial": "node scripts/backfill-all-prompt-editorial.mjs",
        "db:backfill:editorial": "node scripts/backfill-prompt-editorial-content.mjs",
        "db:backfill:public-prompt-eligibility": "node scripts/run-database-migration.mjs --script=backfill-public-prompt-eligibility.mjs",
        "db:migrate": "node scripts/run-database-migration.mjs",
        "db:migrate:editorial": "node scripts/run-database-migration.mjs --script=add-prompt-editorial-columns.mjs",
        "db:migrate:public-prompt-eligibility": "node scripts/run-database-migration.mjs --script=add-public-prompt-eligibility.mjs",
        "db:migrate:remove-sitemap-prompt-eligibility": "node scripts/run-database-migration.mjs --script=remove-sitemap-prompt-eligibility.mjs",
        "db:migrate:site-review-profiles": "node scripts/run-database-migration.mjs --script=add-site-review-profiles.mjs",
        "db:migrate:site-reviews": "node scripts/run-database-migration.mjs --script=add-site-reviews.mjs",
        "db:regenerate:boilerplate": "node scripts/regenerate-prompt-boilerplate.mjs",
        "db:verify:editorial": "node scripts/verify-editorial-content.mjs",
        "db:verify:public-prompt-eligibility": "node scripts/verify-public-prompt-eligibility-equivalence.mjs",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "dev": "node scripts/patch-next-lockfile.cjs && next dev --webpack",
        "lint": "eslint . --quiet",
        "lint:warn": "eslint .",
        "prebuild": "node scripts/patch-next-lockfile.cjs && node scripts/generate-prompt-thumbnails.mjs && node scripts/build-content.mjs",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "start": "next start",
        "sync:content": "node scripts/build-content.mjs",
        "test:environment": "node scripts/verify-environment-modes.mjs",
        "test:google-cmp": "node scripts/test-google-cmp-consent.mjs",
        "test:google-cmp:runtime": "node scripts/verify-google-cmp-runtime.mjs",
        "test:migration-safety": "node scripts/test-database-migration-safety.mjs",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "vercel-build": "npm run sync:content && npm run audit:isr && npm run verify:quarantine-public && npm run verify:tombstones && npm run verify:production-env && npm run audit:image-provenance && npm run audit:adsense-preflight && npm run lint && npm run build && npm run audit:adsense-artifacts",
        "verify:image-rights": "node scripts/verify-image-rights.mjs",
        "verify:live-browser": "node scripts/verify-live-browser.mjs",
        "verify:live-production": "node scripts/verify-live-production.mjs",
        "verify:live-quarantine": "node scripts/verify-live-quarantined-assets.mjs",
        "verify:phase4:runtime": "node scripts/verify-phase4-runtime.mjs",
        "verify:production-env": "node scripts/verify-production-env.mjs",
        "verify:prompt-indexing": "node scripts/verify-prompt-indexing.mjs",
        "verify:quarantine-public": "node scripts/quarantine-public-assets.mjs",
        "verify:testing-claims": "node scripts/verify-testing-claims.mjs",
        "verify:tombstones": "node scripts/verify-tombstone-replacements.mjs"
    },
    "browserslist": [
        "chrome >= 100",
        "safari >= 15",
        "firefox >= 100",
        "edge >= 100"
    ],
    "dependencies": {
        "@mdx-js/mdx": "^3.1.1",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@neondatabase/serverless": "^1.1.0",
        "@radix-ui/react-label": "^2.1.1",
        "@radix-ui/react-slot": "^1.1.1",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "@tiptap/extension-color": "^2.27.2",
        "@tiptap/extension-highlight": "^2.27.2",
        "@tiptap/extension-image": "^2.27.2",
        "@tiptap/extension-link": "^2.27.2",
        "@tiptap/extension-placeholder": "^2.27.2",
        "@tiptap/extension-table": "^2.27.3",
        "@tiptap/extension-table-cell": "^2.27.3",
        "@tiptap/extension-table-header": "^2.27.3",
        "@tiptap/extension-table-row": "^2.27.3",
        "@tiptap/extension-text-align": "^2.27.2",
        "@tiptap/extension-text-style": "^2.27.2",
        "@tiptap/extension-underline": "^2.27.2",
        "@tiptap/pm": "^2.27.2",
        "@tiptap/react": "^2.27.2",
        "@tiptap/starter-kit": "^2.27.2",
        "@upstash/redis": "^1.41.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "html-react-parser": "^6.1.7",
        "js-yaml": "^4.1.1",
        "lowlight": "^3.3.0",
        "lucide-react": "^0.469.0",
        "next": "16.3.8",
        "pg": "^8.22.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "remark-gfm": "^4.0.1",
        "remark-html": "^16.0.0",
        "remark-parse": "^11.0.0",
        "resend": "^6.16.0",
        "sharp": "^0.34.5",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "turndown": "^7.1.2",
        "unified": "^11.0.0",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@opennextjs/cloudflare": "1.20.11",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "wrangler": "^4.148.0"
    }
}
